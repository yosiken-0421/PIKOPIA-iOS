rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pikopia_rooms/{roomCode} {
      function authd() { return request.auth != null; }
      function validScore(x) { return x is int && x >= 0 && x <= resource.data.count * 100; }
      // Invite-only by unguessable room code; there is no collection listing.
      allow get: if authd();
      allow list: if false;
      allow create: if authd()
        && roomCode.matches('[A-HJ-NP-Z2-9]{8}')
        && request.resource.data.keys().hasAll(['hostUid','hostName','guestUid','guestName','hostScore','guestScore','difficulty','count','seed','createdAt'])
        && request.resource.data.keys().hasOnly(['hostUid','hostName','guestUid','guestName','hostScore','guestScore','difficulty','count','seed','createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 14
        && request.resource.data.guestUid == null && request.resource.data.guestName == null
        && request.resource.data.hostScore == -1 && request.resource.data.guestScore == -1
        && request.resource.data.count in [3,5,6]
        && request.resource.data.difficulty in ['easy','normal','hard']
        && request.resource.data.seed is int
        && request.resource.data.createdAt is int;
      allow update: if authd() && (
        (
          resource.data.guestUid == null && request.auth.uid != resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid','guestName'])
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 14
        ) || (
          request.auth.uid == resource.data.hostUid && resource.data.guestUid != null
          && resource.data.hostScore == -1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostScore'])
          && validScore(request.resource.data.hostScore)
        ) || (
          request.auth.uid == resource.data.guestUid && resource.data.guestUid != null
          && resource.data.guestScore == -1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestScore'])
          && validScore(request.resource.data.guestScore)
        )
      );
      allow delete: if false;
    }
  }
}
